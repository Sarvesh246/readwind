# Runtime: use a restricted role on a development branch locally. Never copy production credentials here.
DATABASE_URL=
READWIND_BACKEND=neon
# Supabase backend: use the restricted runtime role and transaction pooler.
SUPABASE_URL=
SUPABASE_ANON_KEY=
READWIND_SESSION_SECRET=
READWIND_STORAGE_TOKEN=
# Set during device recovery; older clients are blocked until their caches are preserved.
READWIND_RECOVERY_EPOCH=
READWIND_RECOVERY_ACCOUNT_EMAIL=
NEON_AUTH_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2

# Schema-owner connection supplied only to the migration process, never the Worker.
MIGRATION_DATABASE_URL=

# Catalog browsing remains disabled until the schema and a published batch are ready.
READWIND_CATALOG_ENABLED=false
# Local worker only. Never put this publication credential in the hosting environment.
CATALOG_DATABASE_URL=
CATALOG_BUCKET=folio-books
READWIND_CATALOG_AUTO_PUBLISH=false
READWIND_CATALOG_TARGET_VERIFIED=false
# Total VERIFIED free object-storage allowance and current non-catalog usage in bytes.
# The worker reserves 20% headroom. Empty values deliberately stop publication.
READWIND_CATALOG_BUDGET_BYTES=
READWIND_CATALOG_BASELINE_BYTES=
# Optional: keep the Supabase database but store files in an S3-compatible bucket (e.g. Backblaze B2).
# READWIND_STORAGE=s3
# READWIND_S3_BUCKET=
