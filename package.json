{
  "name": "readwind",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/build-readwind.mjs",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "vitest run --config vitest.config.ts",
    "test:fullscreen": "node scripts/test-fullscreen-browser.mjs",
    "test:offline": "node scripts/test-offline-browser.mjs",
    "test:reader": "node scripts/test-reader-browser.mjs",
    "test:pdf": "node scripts/test-pdf-browser.mjs",
    "test:import": "node scripts/test-import-browser.mjs",
    "test:chapters": "node scripts/test-chapters-browser.mjs",
    "test:reading-layout": "node scripts/test-reading-layout-browser.mjs",
    "test:fidelity": "node scripts/test-book-fidelity-browser.mjs",
    "test:edge-import": "node scripts/test-edge-case-import-browser.mjs",
    "test:auto-ocr": "node scripts/test-auto-ocr-browser.mjs",
    "test:pace": "node scripts/test-reading-pace-browser.mjs",
    "test:pagination": "node scripts/test-pagination-browser.mjs",
    "test:sync": "node scripts/test-sync-browser.mjs",
    "test:library": "node scripts/test-library-browser.mjs",
    "test:deletion": "node scripts/test-deletion-browser.mjs",
    "test:import-status": "node scripts/test-import-status-browser.mjs",
    "test:book-title": "node scripts/test-book-title-browser.mjs",
    "test:rename": "node scripts/test-book-rename-browser.mjs",
    "test:cloud": "node --env-file=.env.local scripts/test-cloud.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "node --env-file=.env.local scripts/migrate-readwind.mjs",
    "audit:security": "npm audit --audit-level=low",
    "db:check": "node --env-file-if-exists=.env.local scripts/check-readwind-schema.mjs",
    "test:auth": "node scripts/test-auth-browser.mjs",
    "catalog": "node --env-file-if-exists=.env.local --env-file-if-exists=work/catalog/worker.env scripts/catalog/worker.mjs",
    "catalog:migrate": "node --env-file-if-exists=.env.local scripts/catalog/migrate.mjs",
    "test:catalog": "node scripts/test-catalog-browser.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@neon/config": "^1.9.5",
    "@neondatabase/serverless": "^1.2.0",
    "@shadcn/react": "^0.3.0",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fflate": "0.8.3",
    "html-to-image": "^1.11.13",
    "input-otp": "^1.4.2",
    "jose": "^6.2.14",
    "lucide-react": "^1.31.0",
    "motion": "^14.8.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "^7.0.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "better-auth": "1.7.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "5.20261030.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.4.0",
    "vite": "8.3.5",
    "wrangler": "4.156.0",
    "vitest": "^5.0.5",
    "@playwright/test": "1.64.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "@tesseract.js-data/fra": "1.0.0",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/por": "1.0.0",
    "@tesseract.js-data/hin": "1.0.0",
    "@tesseract.js-data/ara": "1.0.0",
    "@tesseract.js-data/jpn": "1.0.0",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@electric-sql/pglite": "0.5.13"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    },
    "better-auth": "$better-auth",
    "@better-auth/core": "1.7.14",
    "@better-auth/oauth-provider": "1.7.14",
    "@better-auth/drizzle-adapter": "1.7.14",
    "zod": "$zod",
    "@better-fetch/fetch": "1.3.3",
    "better-call": "1.4.4",
    "fflate": "0.8.3"
  }
}
