# Dependencies
/node_modules/
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Public setup template; never commit actual environment files.
!.env.example

# Local tool state and design source material
/.claude/
/.skipper/
/.neon
/reference/

# OCR language data is copied from pinned npm packages during build.
/public/ocr/lang/
.vercel
# Skipper — machine-local artifacts (hook scratch + derived index), never commit
.claude/.skipper-*
.skipper/*
!.skipper/receipts/

# Local tooling artifacts and recovery handoff notes, never part of the app
.claude-flow/
.playwright-mcp/
agentdb.rvf
agentdb.rvf.lock
ruvector.db
plugins/
supabase/.temp/
READWIND-RECOVERY-HANDOFF.md
